{
  "name": "ultimate-football-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ultimate Football Simulator: a 3D browser football game built with Three.js and TypeScript.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "test:sim": "tsx tests/sim.test.ts",
    "test:e2e": "node tests/e2e.cjs",
    "test:online": "node tests/online.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
