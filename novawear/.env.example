# ─── NovaWear environment configuration ────────────────────────
# Copy to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string (local, Neon, Supabase, Vercel Postgres…)
DATABASE_URL="postgresql://novawear:novawear_dev@localhost:5432/novawear?schema=public"

# Public base URL (used for metadata, sitemap and links in emails). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Shop currency (ISO 4217 code). Prices are entered in the admin in this currency.
NEXT_PUBLIC_CURRENCY="EUR"

# ─── Email (optional) ─────────────────────────────────────────
# When SMTP_HOST is empty, emails are printed to the server log instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
EMAIL_FROM="NovaWear <hello@novawear.example>"
# Receives a message for every new order.
ADMIN_NOTIFICATION_EMAIL=""

# ─── First administrator (used by `npm run db:seed`) ──────────
ADMIN_EMAIL="admin@novawear.example"
ADMIN_PASSWORD="change-me-to-a-long-password"
ADMIN_NAME="NovaWear Admin"
