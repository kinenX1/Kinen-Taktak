# ─── MovEra environment configuration ──────────────────────────
# Copy to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string
DATABASE_URL="postgresql://movera:movera_dev@localhost:5432/movera?schema=public"

# Public base URL (used for metadata, sitemap, emails). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Legacy folder for project files uploaded before files moved into the
# database. New uploads (attachments, CVs, profile photos) are stored in
# PostgreSQL so they work on serverless hosting.
UPLOAD_DIR="./storage/uploads"

# ─── Email (optional) ─────────────────────────────────────────
# When SMTP_HOST is empty, emails are logged to the server console instead.
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and use these values:
#   SMTP_HOST="smtp.gmail.com"  SMTP_PORT="465"  SMTP_SECURE="true"
#   SMTP_USER="MovEra.Company@gmail.com"  SMTP_PASSWORD="<16-letter app password>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
EMAIL_FROM="MovEra <MovEra.Company@gmail.com>"
# Receives notifications about new project requests, chat messages,
# contact messages and job applications.
ADMIN_NOTIFICATION_EMAIL=""

# ─── Initial administrator (used by `npm run db:seed`) ─────────
ADMIN_EMAIL="admin@movera.example"
ADMIN_PASSWORD="change-me-to-a-long-password"
ADMIN_NAME="MovEra Admin"
