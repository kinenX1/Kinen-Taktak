# ─── MovEra environment configuration ──────────────────────────
# Copy to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string
DATABASE_URL="postgresql://movera:movera_dev@localhost:5432/movera?schema=public"

# Public base URL (used for metadata, sitemap, emails). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Where uploaded project files are stored (outside /public on purpose).
UPLOAD_DIR="./storage/uploads"

# ─── Email (optional) ─────────────────────────────────────────
# When SMTP_HOST is empty, emails are logged to the server console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
EMAIL_FROM="MovEra <hello@movera.example>"
# Receives notifications about new project requests and contact messages.
ADMIN_NOTIFICATION_EMAIL=""

# ─── Initial administrator (used by `npm run db:seed`) ─────────
ADMIN_EMAIL="admin@movera.example"
ADMIN_PASSWORD="change-me-to-a-long-password"
ADMIN_NAME="MovEra Admin"
